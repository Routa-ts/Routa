                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "export default route({\n  get: createRoute({\n    input: { params: GetUserParams },\n    responses: {\n      success: { status: 200, schema: GetUserResponse },\n      notFound: { status: 404, schema: NotFound },\n    },\n    run: async ({ input, response }) =>\n      response.success(await users.find(input.params.userId)),\n  }),\n});",
