                          "content": "const route = createRouteRoot(\"/tenants/:tenantId/projects\");\n\nexport default route({\n  get: createRoute({\n    input: { params: ListProjectsParams, query: ListProjectsQuery },\n    responses: {\n      success: { status: 200, schema: ListProjectsResponse },\n    },\n    run: ({ ctx, input }) => ({ type: \"success\", data: list(ctx, input) }),\n  }),\n});",
