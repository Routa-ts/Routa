            },
            {
              "type": "text",
              "id": "VABzI",
              "name": "Title",
              "fill": "#3D3400",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Animate the path through different folders",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 20,
              "fontWeight": "800"
            },
            {
              "type": "text",
              "id": "O4C3I",
              "name": "Body",
              "fill": "#3D3400",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Cycle the big path and its labels through a few folder trees, about 3 s each:\n\n• tenants/ $tenantId/ projects/route.ts → /tenants/:tenantId/projects\n• status/route.ts → /status\n• users/ $userId/ sessions/route.ts → /users/:userId/sessions\n• orders/ $orderId/route.ts → /orders/:orderId\n\nSwap one segment at a time, left to right. The underline bars resize to each new segment, and the captions crossfade with them. Params ($name → :name) keep the muted color.\n\nEvery path must fit the 1280px column at 88px. With prefers-reduced-motion, show the first example and don't animate.",
              "lineHeight": 1.45,
              "fontFamily": "Inter",
              "fontSize": 15,
              "fontWeight": "normal"
            }
          ]
        }
      ]
