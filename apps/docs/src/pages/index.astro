---
/**
 * Production marketing landing — Schematic composition (Lattice).
 * Docs live under /docs/.
 */
import "../styles/landing.css";

const title = "Routa — Schema-first REST for TypeScript";
const description =
	"Filesystem routes with Zod contracts and OpenAPI in lockstep. Schema-first REST for new TypeScript APIs.";
const canonical = new URL("/", Astro.site).href;
const ogImage = new URL("/og.png", Astro.site).href;

/**
 * `create` commands mirror the `PackageManagers` component used across the docs
 * so the landing page and the docs never drift on install syntax.
 */
const createCommands = [
	{ id: "npm", command: "npm create routa-ts@latest" },
	{ id: "pnpm", command: "pnpm create routa-ts@latest" },
	{ id: "yarn", command: "yarn create routa-ts" },
	{ id: "bun", command: "bun create routa-ts@latest" },
] as const;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>{title}</title>
		<meta name="description" content={description}>
		<link rel="canonical" href={canonical}>
		<meta property="og:type" content="website">
		<meta property="og:site_name" content="Routa">
		<meta property="og:locale" content="en">
		<meta property="og:url" content={canonical}>
		<meta property="og:title" content={title}>
		<meta property="og:description" content={description}>
		<meta property="og:image" content={ogImage}>
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta
			property="og:image:alt"
			content="Routa — filesystem routes with contracts. Schema-first REST for TypeScript."
		>
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:title" content={title}>
		<meta name="twitter:description" content={description}>
		<meta name="twitter:image" content={ogImage}>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg">
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link
			href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Space+Mono:wght@400;700&display=swap"
			rel="stylesheet"
		>
	</head>
	<body>
		<a class="skip" href="#main">Skip to content</a>
		<main id="main" class="lp-schematic">
			<section class="hero" aria-label="Hero">
				<svg
					class="map"
					viewBox="0 0 1200 700"
					preserveAspectRatio="xMidYMid slice"
					aria-hidden="true"
				>
					<path class="edge" d="M140 270 L350 180 L560 100" pathLength="1"></path>
					<path class="edge" d="M560 100 L720 240 L920 320" pathLength="1"></path>
					<path class="edge" d="M560 100 L800 100" pathLength="1"></path>
					<path class="edge" d="M800 100 L1060 190 L920 320" pathLength="1"></path>
					<circle class="node" cx="140" cy="270" r="8"></circle>
					<circle class="node lit" cx="350" cy="180" r="9"></circle>
					<circle class="node" cx="560" cy="100" r="8"></circle>
					<circle class="node lit" cx="720" cy="240" r="9"></circle>
					<circle class="node" cx="920" cy="320" r="8"></circle>
					<circle class="node" cx="800" cy="100" r="7"></circle>
					<circle class="node lit" cx="1060" cy="190" r="8"></circle>
					<text x="140" y="248">route</text>
					<text x="350" y="158">schema</text>
					<text x="560" y="78">middleware</text>
					<text x="720" y="218">handler</text>
					<text x="920" y="298">response</text>
					<text x="800" y="78">openapi</text>
					<text x="1060" y="168">check</text>
				</svg>

				<div class="hero-copy">
					<div class="brand-mark">
						<img src="/favicon.svg" alt="" width="40" height="40">
						Routa
						<span class="dot" aria-hidden="true"></span>
					</div>
					<h1 class="headline">Filesystem routes with contracts, not vibes</h1>
					<p class="lede">
						A schematic of the API: routes as edges, schemas as nodes, OpenAPI as projection.
						Schema-first REST for TypeScript — Zod contracts on a Hono runtime.
					</p>
					<div class="cta-row">
						<a class="btn btn-primary" href="/docs/">Get started</a>
						<a class="btn btn-ghost" href="https://github.com/Routa-ts/Routa">GitHub</a>
					</div>
					<div class="cli">
						<div class="cli-tabs" role="tablist" aria-label="Package manager">
							{createCommands.map(({ id }, index) => (
									<button
										type="button"
										role="tab"
										id={`pm-tab-${id}`}
										aria-controls="pm-panel"
										aria-selected={index === 0 ? "true" : "false"}
										tabindex={index === 0 ? 0 : -1}
										data-pm={id}
									>
										{id}
									</button>
								))}
						</div>
						<div class="cli-body">
							<code
								id="pm-panel"
								role="tabpanel"
								aria-labelledby="pm-tab-npm"
								data-cmd={createCommands[0].command}
							>
								<span aria-hidden="true">$</span>
								<span data-cmd-text>{createCommands[0].command}</span>
							</code>
							<button type="button" class="cli-copy">Copy</button>
							<span class="visually-hidden" role="status" data-copy-status></span>
						</div>
					</div>
				</div>
			</section>

			<section class="section">
				<div class="section-inner">
					<p class="section-kicker">Side by side</p>
					<h2 class="section-title">Untyped handler vs contracted route</h2>
					<p class="section-lede">
						Same job. One hopes the status codes match the docs. The other declares the contract in
						source.
					</p>
					<div class="compare">
						<div class="code-panel">
							<div class="code-panel__bar">
								<span>without Routa</span><span>vibes</span>
							</div>
							<pre
							><code>app.post(<span class="str">"/users"</span>, <span class="kw">async</span> (c) => {"{"}
  <span class="kw">const</span> body = <span class="kw">await</span> c.req.json();
  <span class="cm">// validate… somewhere?</span>
  <span class="kw">const</span> user = <span class="kw">await</span> create(body);
  <span class="kw">return</span> c.json(user, <span class="str">201</span>);
{"}"});</code></pre>
						</div>
						<div class="code-panel">
							<div class="code-panel__bar">
								<span>with Routa</span><span>contract</span>
							</div>
							<pre
							><code><span class="kw">const</span> route = <span class="fn">createRouteRoot</span>(<span class="str">"/users"</span>);

<span class="kw">export default</span> route({"{"}
  post: <span class="fn">createRoute</span>({"{"}
    input: {"{"} body: CreateUserSchema {"}"},
    responses: {"{"}
      success: {"{"} status: <span class="str">201</span>, schema: UserSchema {"}"},
    {"}"},
    run: <span class="kw">async</span> ({"{"} input {"}"}) => ({"{"}
      type: <span class="str">"success"</span>,
      data: <span class="kw">await</span> users.createUser(input.body),
    {"}"}),
  {"}"}),
{"}"});</code></pre>
						</div>
					</div>
					<ul class="pillars" style="margin-top: 2.5rem">
						<li>
							<strong>Route = contract</strong>
							<p>Path, methods, I/O, and outcomes in one file.</p>
						</li>
						<li>
							<strong>Lattice composition</strong>
							<p>Middleware and schemas form a typed graph you can check.</p>
						</li>
						<li>
							<strong>OpenAPI peer</strong>
							<p>Projection of the same lattice — scaffold or emit.</p>
						</li>
						<li>
							<strong>CLI lifecycle</strong>
							<p>check, build, start — in that order.</p>
						</li>
					</ul>
					<ul class="built-on" style="margin-top: 2rem">
						<li>Hono</li>
						<li>Zod</li>
						<li>OpenAPI</li>
						<li>TypeScript</li>
					</ul>
					<p class="v0-note">
						<strong>v0</strong>
						— intentionally narrow. Schema-first REST, not a fullstack meta-framework.
					</p>
				</div>
			</section>

			<section class="close">
				<div class="close-inner">
					<div>
						<h2>Map the docs</h2>
						<p>From first route to OpenAPI lockstep.</p>
					</div>
					<div class="cta-row">
						<a class="btn btn-primary" href="/docs/start/quickstart/">Quickstart</a>
						<a class="btn btn-ghost" href="/docs/">Documentation</a>
					</div>
				</div>
			</section>
		</main>
		<script>
		type PackageManager = "npm" | "pnpm" | "yarn" | "bun";

		const COMMANDS: Record<PackageManager, string> = {
			npm: "npm create routa-ts@latest",
			pnpm: "pnpm create routa-ts@latest",
			yarn: "yarn create routa-ts",
			bun: "bun create routa-ts@latest",
		};

		/**
		 * Starlight persists synced tab selections under this key, so the choice made
		 * here carries into every `<PackageManagers>` block in the docs and back.
		 */
		const STORAGE_KEY = "starlight-synced-tabs__pkg";

		const cli = document.querySelector(".cli");
		const tabs = [...document.querySelectorAll<HTMLButtonElement>(".cli-tabs [data-pm]")];
		const panel = document.querySelector<HTMLElement>("#pm-panel");
		const commandText = document.querySelector<HTMLElement>("[data-cmd-text]");
		const copyButton = document.querySelector<HTMLButtonElement>(".cli-copy");
		const copyStatus = document.querySelector<HTMLElement>("[data-copy-status]");

		function isPackageManager(value: string | null): value is PackageManager {
			return value !== null && value in COMMANDS;
		}

		function select(manager: PackageManager, { focus = false } = {}) {
			if (!panel || !commandText) return;

			for (const tab of tabs) {
				const selected = tab.dataset.pm === manager;
				tab.setAttribute("aria-selected", String(selected));
				tab.tabIndex = selected ? 0 : -1;
				if (selected && focus) tab.focus();
			}

			commandText.textContent = COMMANDS[manager];
			panel.dataset.cmd = COMMANDS[manager];
			panel.setAttribute("aria-labelledby", `pm-tab-${manager}`);
		}

		if (cli && panel && commandText) {
			const stored = localStorage.getItem(STORAGE_KEY);
			if (isPackageManager(stored)) select(stored);

			for (const tab of tabs) {
				tab.addEventListener("click", () => {
					const manager = tab.dataset.pm;
					if (!isPackageManager(manager ?? null)) return;
					select(manager as PackageManager);
					localStorage.setItem(STORAGE_KEY, manager as PackageManager);
				});
			}

			cli.querySelector(".cli-tabs")?.addEventListener("keydown", (event) => {
				const key = (event as KeyboardEvent).key;
				const step = key === "ArrowRight" ? 1 : key === "ArrowLeft" ? -1 : 0;
				if (step === 0) return;
				event.preventDefault();

				const current = tabs.findIndex((tab) => tab.getAttribute("aria-selected") === "true");
				const next = tabs[(current + step + tabs.length) % tabs.length];
				const manager = next?.dataset.pm;
				if (!isPackageManager(manager ?? null)) return;
				select(manager as PackageManager, { focus: true });
				localStorage.setItem(STORAGE_KEY, manager as PackageManager);
			});
		}

		copyButton?.addEventListener("click", async () => {
			const command = panel?.dataset.cmd;
			if (!command) return;
			try {
				await navigator.clipboard.writeText(command);
				copyButton.textContent = "Copied";
				if (copyStatus) copyStatus.textContent = `Copied ${command} to clipboard`;
				setTimeout(() => {
					copyButton.textContent = "Copy";
					if (copyStatus) copyStatus.textContent = "";
				}, 1400);
			} catch {
				copyButton.textContent = "Failed";
				if (copyStatus) copyStatus.textContent = "Copy failed";
			}
		});
		</script>
	</body>
</html>
