{
	"name": "@routa-ts/cli",
	"version": "0.5.0",
	"description": "CLI for Routa route checks, scaffolding, and dev server",
	"private": false,
	"type": "module",
	"license": "MIT",
	"keywords": [
		"routa",
		"cli",
		"rest",
		"typescript",
		"openapi",
		"scaffold"
	],
	"homepage": "https://routa-ts.dev",
	"bugs": {
		"url": "https://github.com/Routa-ts/Routa/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Routa-ts/Routa.git",
		"directory": "packages/cli"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public"
	},
	"bin": {
		"routa": "dist/index.js"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"typecheck": "vp exec tsc -p tsconfig.json --noEmit && vp exec tsc -p tsconfig.test.json --noEmit",
		"lint": "vp lint",
		"test": "vp test run --coverage"
	},
	"dependencies": {
		"@hono/node-server": "2.1.5",
		"@routa-ts/core": "workspace:*",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"create-routa-ts": "workspace:*",
		"zod": "^4.6.7"
	}
}
